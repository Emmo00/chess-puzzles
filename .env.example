# Application Environment
NODE_ENV=development
PORT=8000
APP_PATH=127.0.0.1

# MongoDB Database (Required)
# Local: mongodb://127.0.0.1:27017/chess-puzzles
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/chess-puzzles
MONGO_CONNECTION_URL=mongodb://127.0.0.1:27017/chess-puzzles

# Chess Puzzle API (Required - Get from RapidAPI)
# Sign up at https://rapidapi.com/ and subscribe to Chess Puzzles API
PUZZLE_API_URL=chess-puzzles.p.rapidapi.com
PUZZLE_API_KEY=your_rapidapi_key_here

# Adaptive difficulty (Section 6) - number of recent solves used to tune difficulty
ADAPTIVE_WINDOW_SIZE=8

# GameAssets Contract - The server wallet holding the CONSUMER_ROLE
# Used to deduct hints/streak freezes from users on the contract
# Generate a private key and grant it CONSUMER_ROLE on the contract after deployment
# CONSUMER_PRIVATE_KEY=0x...

# Celo RPC URL (optional - defaults to forno.celo.org)
# Using a paid provider like Alchemy avoids rate limits
NEXT_PUBLIC_ALCHEMY_RPC_URL=

# GameAssets Contract - Server wallet holding ADMIN_ROLE
# Used to grant hints/streak freezes for milestone rewards
# This should be a different key from CONSUMER_PRIVATE_KEY
# GAME_ASSETS_ADMIN_KEY=0x...

# Once the GameAssets contract is deployed, set this address:
# GAME_ASSETS_CONTRACT=0x...
