{
  "name": "chess-puzzles",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "bun --filter chess-puzzles-frontend dev",
    "dev:backend": "bun --filter chess-puzzles-backend dev",
    "dev": "bun run --parallel dev:frontend dev:backend",
    "build": "bun --filter chess-puzzles-frontend build && bun --filter chess-puzzles-backend build",
    "test": "bun --filter chess-puzzles-frontend test"
  }
}
