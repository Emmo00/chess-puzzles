# Admin App Environment

# Required — secret key for signing/verifying JWT admin sessions (use a strong random string)
JWT_SECRET=

# Required — comma-separated list of wallet addresses allowed to log in as admin
ADMIN_WALLETS=

# Optional — Celo RPC URL (defaults to https://forno.celo.org)
NEXT_PUBLIC_ALCHEMY_RPC_URL=

# Optional — Backend API URL for proxied actions like granting assets (defaults to http://localhost:8000)
NEXT_PUBLIC_API_URL=
